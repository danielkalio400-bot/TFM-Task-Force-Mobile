{
  "version": 1,
  "systems": [
    "friend-requests",
    "friend-relationships",
    "player-blocks",
    "profile-visibility",
    "presence-privacy",
    "party-invite-privacy",
    "direct-message-privacy",
    "clans",
    "clan-membership",
    "clan-roles",
    "clan-privacy",
    "moderation-aware-social-actions"
  ],
  "privacyDefaults": {
    "profileVisibility": "friends",
    "showOnlineStatus": true,
    "allowFriendRequests": true,
    "allowClanInvites": true
  },
  "rule": "Social features must respect blocks, privacy settings, consent and moderation state before exposing presence or enabling invites."
}
