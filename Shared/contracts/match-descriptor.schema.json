{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tfm.invalid/contracts/match-descriptor.schema.json",
  "title": "TFM Match Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["matchId", "sectionId", "playlist", "region", "playerIds", "state"],
  "properties": {
    "matchId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sectionId": { "enum": ["mp", "br", "zombies", "dmz"] },
    "playlist": { "type": "string", "minLength": 1, "maxLength": 64 },
    "region": { "type": "string", "minLength": 2, "maxLength": 24 },
    "playerIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 128 },
      "minItems": 1
    },
    "state": { "enum": ["forming", "ready", "active", "complete", "cancelled"] }
  }
}
