{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tfm.invalid/contracts/player-report.schema.json",
  "title": "TFM Player Report",
  "type": "object",
  "required": ["reporterPlayerId", "reportedPlayerId", "category"],
  "properties": {
    "reporterPlayerId": { "type": "string", "minLength": 1 },
    "reportedPlayerId": { "type": "string", "minLength": 1 },
    "matchId": { "type": "string" },
    "category": {
      "enum": ["harassment", "hate-or-abuse", "cheating", "exploit-abuse", "inappropriate-name", "voice-or-chat-abuse", "other"]
    },
    "note": { "type": "string", "maxLength": 500 }
  }
}
