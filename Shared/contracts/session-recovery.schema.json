{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tfm.invalid/contracts/session-recovery.schema.json",
  "title": "TFM Session Recovery",
  "type": "object",
  "required": ["recoveryId", "playerId", "matchId", "state", "expiresAt"],
  "properties": {
    "recoveryId": { "type": "string", "minLength": 1 },
    "playerId": { "type": "string", "minLength": 1 },
    "matchId": { "type": "string", "minLength": 1 },
    "state": { "enum": ["issued", "consumed", "expired"] },
    "expiresAt": { "type": "string", "format": "date-time" }
  }
}
