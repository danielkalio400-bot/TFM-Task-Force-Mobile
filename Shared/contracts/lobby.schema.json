{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tfm.invalid/contracts/lobby.schema.json",
  "title": "TFM Lobby",
  "type": "object",
  "required": ["lobbyId", "ownerPlayerId", "maxPlayers", "members"],
  "properties": {
    "lobbyId": { "type": "string", "minLength": 1 },
    "ownerPlayerId": { "type": "string", "minLength": 1 },
    "maxPlayers": { "type": "integer", "minimum": 1, "maximum": 16 },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["playerId", "platform", "ready"],
        "properties": {
          "playerId": { "type": "string", "minLength": 1 },
          "platform": { "enum": ["android", "ios", "windows"] },
          "ready": { "type": "boolean" }
        }
      }
    }
  }
}
