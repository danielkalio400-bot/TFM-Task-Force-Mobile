{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tfm.invalid/contracts/matchmaking-ticket.schema.json",
  "title": "TFM Matchmaking Ticket Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["playerId", "sectionId", "playlist", "platform", "region"],
  "properties": {
    "playerId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sectionId": { "enum": ["mp", "br", "zombies", "dmz"] },
    "playlist": { "type": "string", "minLength": 1, "maxLength": 64 },
    "platform": { "enum": ["android", "ios", "windows"] },
    "region": { "type": "string", "minLength": 2, "maxLength": 24 }
  }
}
