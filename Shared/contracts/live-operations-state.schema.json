{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tfm.invalid/contracts/live-operations-state.schema.json",
  "title": "TFM Live Operations State",
  "type": "object",
  "required": ["region", "matchmakingEnabled", "rankedEnabled", "privateMatchesEnabled", "newServerAssignmentsEnabled"],
  "properties": {
    "region": { "type": "string", "minLength": 2 },
    "matchmakingEnabled": { "type": "boolean" },
    "rankedEnabled": { "type": "boolean" },
    "privateMatchesEnabled": { "type": "boolean" },
    "newServerAssignmentsEnabled": { "type": "boolean" },
    "maintenanceMessage": { "type": "string", "maxLength": 240 }
  }
}
