{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tfm.invalid/contracts/map-vote.schema.json",
  "title": "TFM Map Vote",
  "type": "object",
  "required": ["voteId", "matchId", "modeId", "options", "closesAt"],
  "properties": {
    "voteId": { "type": "string", "minLength": 1 },
    "matchId": { "type": "string", "minLength": 1 },
    "modeId": { "type": "string", "minLength": 1 },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "closesAt": { "type": "string", "format": "date-time" }
  }
}
